# ---------------------------------------------------------------------------
# AkaLonics configuration. Every value below has a working default: with an
# empty environment the API runs on SQLite + local disk with zero infra.
# ---------------------------------------------------------------------------

# Core
DEBUG=true                      # false in production (locks CORS to ALLOWED_ORIGINS)
LOG_LEVEL=INFO

# Persistence — unset => SQLite at backend/.data/akalonics.db
# DATABASE_URL=postgresql+asyncpg://akalonics:akalonics@postgres:5432/akalonics
# REDIS_URL=redis://redis:6379/0

# Object storage — local | s3
STORAGE_BACKEND=local
# STORAGE_DIR=/var/lib/akalonics/objects
# S3_BUCKET=akalonics
# S3_ENDPOINT_URL=http://minio:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# Auth
JWT_SECRET=change-me-to-a-32-byte-random-string
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
COOKIE_SECURE=false             # true behind HTTPS
COOKIE_SAMESITE=none            # none => cross-site preview works; use lax for same-site prod

# HTTP
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
MAX_UPLOAD_MB=25

# Limits
RATE_LIMIT_ENABLED=true
RATE_UPLOADS=10/hour
RATE_API=100/minute
RATE_AUTH=5/minute
MAX_ROWS=500000
MAX_COLS=512
MAX_ZIP_MEMBERS=2000
MAX_UNCOMPRESSED_MB=400
PARQUET_TTL_MIN=180

# Async work
USE_WORKER=false                # true + REDIS_URL => arq worker handles uploads

# Observability
# SENTRY_DSN=

# Features
NL_CHARTS_ENABLED=true          # needs ANTHROPIC_API_KEY, else keyword matcher only
NL_MODEL=claude_sonnet_4_6
